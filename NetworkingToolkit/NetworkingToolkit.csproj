<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows</TargetFramework>
		<Nullable>enable</Nullable>
		<UseWindowsForms>true</UseWindowsForms>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>DenDev.ico</ApplicationIcon>
	</PropertyGroup>

	<ItemGroup>
	  <EmbeddedResource Include="DenDev.ico" LogicalName="NetworkingToolkit.DenDev.ico" />
      <EmbeddedResource Include="DenDev.png" LogicalName="NetworkingToolkit.DenDev.png" />
	</ItemGroup>

</Project>